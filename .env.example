# Copy to .env and fill in. .env is gitignored.
# Read by docker-compose.yml. Every value is validated by Zod at boot — a bad
# value exits non-zero with a message naming the variable.
# Full reference: docs/idea/09-deployment.md

# === Admin plane (required) ===
# The single admin identity. There is no user table in v1.
ADMIN_USERNAME=admin

# Plaintext password, hashed with argon2id at boot and never persisted in plaintext.
# This is the documented default: the happy path is three env vars, no hash step.
ADMIN_PASSWORD=change-me

# Pre-computed argon2id hash, for operators who won't put a plaintext secret in an
# env store. TAKES PRECEDENCE over ADMIN_PASSWORD when both are set.
# Exactly one of ADMIN_PASSWORD / ADMIN_PASSWORD_HASH must be present or boot fails.
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=...

# === Encryption (required) ===
# 32 bytes, base64. AES-256-GCM key protecting every upstream credential and every
# router API key at rest. Boot fails loudly if it is missing or short.
# Generate one:  openssl rand -base64 32
# Losing this loses every stored credential — there is no recovery path. Back it up
# SEPARATELY from the database dump; together they are a single-file compromise.
ENCRYPTION_KEY=REPLACE_ME_WITH_openssl_rand_base64_32

# === Database ===
# PostgreSQL 16+ connection string. NOT SET HERE ON PURPOSE: docker-compose.yml
# supplies it, pointing at the bundled `postgres` service, so the three variables
# above are the only ones you fill in by hand.
#
# Only set it here if you are NOT using the bundled service — e.g. a managed
# instance — and remember to drop the `postgres` service from the compose file.
# Note that docker-compose.yml sets DATABASE_URL in its `environment:` block,
# which takes precedence over this file: change it there, not here.
# DATABASE_URL=postgres://user:pass@db.internal:5432/router?sslmode=require

# === Server ===
# Listen port inside the container.
# PORT=8080

# Externally reachable base URL. Only used to build the OAuth redirect-capture
# callback: PUBLIC_URL + /admin/accounts/oauth/callback. Leave unset to use the
# paste-back capture flow, which needs no reachable callback URL.
# PUBLIC_URL=https://router.example.com

# debug | info | warn | error. Logs are structured JSON either way, redacted by default.
# LOG_LEVEL=info

# Honor X-Forwarded-For / X-Forwarded-Proto. Set true ONLY behind a proxy you
# control — otherwise any client can forge its own IP past the rate limiter.
# TRUST_PROXY=false

# === Claude subscriptions (Agent SDK) ===
# Parent directory holding one CLAUDE_CONFIG_DIR per Claude subscription Account
# (spec §11). Must sit on the persistent `claude-config` volume from
# docker-compose.yml — these directories hold live subscription credentials and
# are NOT covered by ENCRYPTION_KEY. Treat the volume as secret material.
# CLAUDE_CONFIG_ROOT=/data/claude

# Minimum seconds between manual "Re-check now" probes of the same account. The
# button re-queries the provider's live quota signal; the cooldown is what stops
# it from being used to hammer an upstream.
# ACCOUNT_RECHECK_COOLDOWN_SECONDS=60

# === Retention / janitor (see docs/idea/09-deployment.md#cleanups--retention) ===
# Idle sticky-session and fingerprint TTL, in hours.
# RETENTION_SESSIONS_HOURS=24

# Raw usage records kept this many days, then rolled up to daily aggregates.
# RETENTION_USAGE_DAYS=90

# Audit events kept this many days. They never contain secrets.
# RETENTION_AUDIT_DAYS=365

# Revoked or expired API keys are purged this many days after revocation, so
# historical usage stays joinable for a while.
# RETENTION_REVOKED_KEYS_DAYS=30

# TTL for one-shot OAuth state values and PKCE verifiers, in minutes.
# RETENTION_OAUTH_STATE_MINUTES=10

# Base sweep interval for the janitor. The actual interval is jittered around it so
# sweeps never pile onto request spikes or onto each other after a restart.
# JANITOR_INTERVAL_MINUTES=60
