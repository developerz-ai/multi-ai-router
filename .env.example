# Copy to .env and fill in. .env is gitignored.
# Read by docker-compose.yml. Every value is validated by Zod at boot — a bad
# value exits non-zero with a message naming the variable.
# Full reference: docs/idea/09-deployment.md
#
# Zero is not how you turn something off. On a numeric knob it is usually a sweep
# that deletes the table it was pointed at, an interval that re-arms every
# millisecond, a cache that answers nothing, or a breaker that never holds — none of
# which log anything and none of which stop traffic. So every numeric variable below
# is REFUSED AT BOOT at 0, except where zero is a real setting and the comment on
# that variable says what it means: PORT, the two SHUTDOWN_*, three of the DB_POOL_*,
# the two *_COOLDOWN_SECONDS, the two *_NEGATIVE_TTL_SECONDS, and the two fractions.

# === Admin plane — sign-in (one method required) ===
# Two ways to sign in to the console; boot refuses when NEITHER exists:
#
#   A. OIDC (this block) — the admin surface is a generic OIDC flow. The router
#      discovers the IdP's endpoints from the issuer URL, verifies the id_token
#      against the IdP's JWKS, and pins the session to the email below. Pinning
#      to a single email is the deliberate scope: rotating identities or RBAC
#      is a follow-up, not a v1. Recommended for anything reachable by more
#      than one machine — the IdP's MFA and audit trail come with it.
#   B. Local admin password — no variables here, ever. Run
#      `bin/admin set-password` on the host: it hashes the password with
#      argon2id and stores ONLY the hash in Postgres. Off by default (a fresh
#      database has no row). Close it again with `bin/admin delete-password`.
#
# The four OIDC fields are all-or-nothing: a partial block fails boot, pointing
# at docs/idea/13-admin-oidc.md. All four absent means "local password only".
#
# The admin email is matched case-insensitively against the IdP-asserted email
# AND the email_verified claim must be true. Set ADMIN_OIDC_ADMIN_SUBJECT to
# pin the IdP's `sub` claim additionally — useful when the IdP reuses emails
# across tenants.
ADMIN_OIDC_ISSUER_URL=https://sso.example.com
ADMIN_OIDC_CLIENT_ID=multi-ai-router
ADMIN_OIDC_CLIENT_SECRET=replace-with-client-secret
ADMIN_OIDC_REDIRECT_URI=https://router.example.com/api/admin/auth/oidc/callback
# Comma-separated. Every entry maps onto the same single admin principal — there are no user
# accounts and no roles; it is a list so a team can share one router without sharing a login.
ADMIN_OIDC_ADMIN_EMAIL=admin@example.com,second.operator@example.com
# ADMIN_OIDC_ADMIN_SUBJECT=

# FAIL-CLOSED rule for the local admin password: while a password row exists,
# boot REFUSES if PUBLIC_URL is set to anything that is not loopback — a
# password-only door on a public address is a credential-guessing surface, and
# it has no IdP and no MFA in front of it. Set this to true only when you accept
# that risk by name (e.g. a LAN install behind its own firewall); boot warns on
# every start while it is on. See docs/idea/13-admin-oidc.md.
# ADMIN_LOCAL_LOGIN_ALLOW_PUBLIC=false

# Scope set, space-separated. `openid` is mandatory; the rest is passed through.
# Defaults to "openid profile email" when unset.
# ADMIN_OIDC_SCOPES=openid profile email

# Maximum tolerated clock skew between the router and the IdP, in seconds.
# Defaults to 60.
# ADMIN_OIDC_CLOCK_SKEW_SECONDS=60

# --- Admin session and login throttle ---
# Sessions live in Postgres (admin_sessions) and survive a redeploy or a crash.
# Sliding idle window; also the session cookie's Max-Age. Thirty days by default —
# a single-operator console behind SSO; the trade is written down in
# docs/idea/13-admin-oidc.md. Raising it leaves a walked-away-from browser a live
# credential for longer; the old posture is 480.
# ADMIN_SESSION_IDLE_MINUTES=43200

# Hard ceiling on a session's total life regardless of activity. A purely sliding
# session is one a thief renews forever; this is what bounds that. The old posture is 24.
# ADMIN_SESSION_ABSOLUTE_HOURS=720

# Failed logins per client IP before the address locks.
# ADMIN_LOGIN_MAX_ATTEMPTS=5

# Failures older than this stop counting toward the lock — yesterday's typo is not evidence.
# ADMIN_LOGIN_ATTEMPT_WINDOW_MINUTES=15

# How long a tripped throttle key stays locked. Longer is safer and locks you out longer.
# ADMIN_LOGIN_LOCKOUT_MINUTES=15

# How long a session's idle-window slide may go unpersisted. In-memory lastSeenAtMs is
# always current in the response; this coalesces the admin_sessions write to one per
# interval per session, fire-and-forget, so no admin request waits on Postgres.
# 0 is legal and means: persist the slide on every authenticated request.
# ADMIN_SESSION_TOUCH_INTERVAL_SECONDS=60

# Sessions the durable store keeps warm in memory per replica, so authenticate() reads
# Postgres once per session it has not seen rather than once per request.
# ADMIN_SESSION_CACHE_MAX=1000

# ESCAPE HATCH for a plain-HTTP install — e.g. reaching the console at
# http://192.168.1.50:8080 on your own LAN. The session cookie ships Secure and
# __Host-, and a browser SILENTLY DISCARDS such a cookie sent over http://: login
# answers 200 and every request after it is 401. The router notices and logs a warn
# naming this variable when that happens, so check the log if the console keeps
# bouncing you back to the login form. Setting this to true drops those two
# attributes and only those two — HttpOnly,
# SameSite=Strict and the CSRF token on every mutation are unaffected.
# You give up: confidentiality on the wire, and the __Host- guarantee that no other
# host sharing this domain can plant a session cookie here. UNSET IT the moment the
# console is served over HTTPS. The router warns on every boot while it is on.
# SESSION_COOKIE_INSECURE=false

# === Encryption (required) ===
# 32 bytes, base64. AES-256-GCM key protecting every upstream credential and every
# router API key at rest. Boot fails loudly if it is missing or short.
# Generate one:  openssl rand -base64 32
# Losing this loses every stored credential — there is no recovery path. Back it up
# SEPARATELY from the database dump; together they are a single-file compromise.
ENCRYPTION_KEY=REPLACE_ME_WITH_openssl_rand_base64_32

# === Database ===
# PostgreSQL 16+ connection string. NOT SET HERE ON PURPOSE: docker-compose.yml
# supplies it, pointing at the bundled `postgres` service, so the three variables
# above are the only ones you fill in by hand.
#
# Only set it here if you are NOT using the bundled service — e.g. a managed
# instance — and remember to drop the `postgres` service from the compose file.
# Note that docker-compose.yml sets DATABASE_URL in its `environment:` block,
# which takes precedence over this file: change it there, not here.
# DATABASE_URL=postgres://user:pass@db.internal:5432/router?sslmode=require
#
# A CHECKOUT is the exception: there is no compose file supplying it, so
# `bin/setup` appends the dev container's URL to the .env it generates. `bin/dev`
# and the live-Postgres tests read it from there. An existing DATABASE_URL is
# never overwritten.

# --- Connection pool ---
# ONE pool serves everything that is not the request path: the admin console, every
# scheduler sweep, the off-path usage/quota/status writers and /readyz. So this is the
# ceiling on all of them at once — a long sweep holding a connection is one fewer for
# the console. Raise it for a busy console or long sweeps; lower it when several
# replicas share a managed instance with its own max_connections, since each replica
# opens its own pool. 0 is REFUSED: it opens nothing and queues every query forever.
# DB_POOL_MAX=10

# How long an idle pooled connection is kept before it is closed.
# 0 is legal and means NEVER close one — a falsy interval is a timer that never fires,
# not "immediately". Same rule for DB_POOL_MAX_LIFETIME_SECONDS below.
# DB_POOL_IDLE_TIMEOUT_SECONDS=30

# How long a dial waits to be accepted before it fails. Raise it for a managed instance
# that is slow to accept; the boot migration uses the same value, so one raise covers
# the connection that runs before the pool exists. 0 is REFUSED: by the rule above it
# would mean wait forever, turning an unreachable database from a failure into a hang.
# DB_POOL_CONNECT_TIMEOUT_SECONDS=10

# Age at which a pooled connection is recycled, so a failover behind a connection proxy
# drains onto the new primary instead of pinning to the old one. 0 never recycles.
# DB_POOL_MAX_LIFETIME_SECONDS=1800

# How long the shutdown's pool close waits for in-flight queries before destroying them.
# It runs AFTER the flush, so an unbounded wait here buys nothing and risks the SIGKILL.
# 0 is legal and destroys the pool at once.
# DB_POOL_CLOSE_TIMEOUT_SECONDS=5

# === Server ===
# Listen port inside the container.
# 0 is legal: the kernel picks an ephemeral port and the boot log names the one it bound.
# PORT=8080

# How long a connection may carry no bytes in either direction before the SERVER closes it,
# in whole seconds. Left unset, Bun applies its own 10 and sweeps every 4 s — shorter than the
# 15 s heartbeat a quiet stream sends to stay alive, so a turn whose tool arguments took 11 s
# to generate (held whole, so the client saw nothing until the block closed) was cut mid-turn
# as "Failed to read … stream" on the client. Keep this comfortably above the heartbeat.
# 255 is the ceiling (Bun keeps it in one byte). 0 is legal and disables the server's clock.
# SERVER_IDLE_TIMEOUT_SECONDS=60

# How long a shutdown lets in-flight responses finish before it stops waiting. On
# SIGTERM /readyz starts answering 503 shutting_down, the router stops accepting, waits
# up to this long for what is already streaming, and only then flushes the usage rows,
# quota readings and account statuses it is holding. Whatever stops the container must allow MORE than this —
# stop_grace_period in docker-compose.yml (30s there), or
# terminationGracePeriodSeconds on Kubernetes — because a kill that lands inside
# the drain truncates the streams AND loses the flush. 0 waits for nothing.
# The container's grace must cover SHUTDOWN_READY_GRACE_MS + this + DB_POOL_CLOSE_TIMEOUT_SECONDS.
# SHUTDOWN_DRAIN_MS=15000

# How long the router keeps SERVING after /readyz starts answering 503 shutting_down and before
# the listener closes — the window a load balancer has to notice and stop sending work here.
# 0 (the default) skips it, which is right under this compose file: nothing here polls readiness,
# so the wait would be pure added shutdown time. On Kubernetes set about two readiness periods
# (periodSeconds default 10s → 20000) and raise terminationGracePeriodSeconds to cover it too.
# SHUTDOWN_READY_GRACE_MS=0

# Externally reachable base URL. Only used to build the OAuth redirect-capture
# callback: PUBLIC_URL + /admin/accounts/oauth/callback. Leave unset to use the
# paste-back capture flow, which needs no reachable callback URL.
# PUBLIC_URL=https://router.example.com

# Directory holding the built admin console, which this process serves at / on its own
# origin (same origin as the API: no CORS, and the session cookie just works). The
# default — dist/web beside the bundled entrypoint — is already right in the image.
# Set it only if the assets live somewhere else, and note that a set path with no
# index.html FAILS BOOT rather than starting a router that looks like a broken web app.
# WEB_ROOT=/app/dist/web

# debug | info | warn | error. Logs are structured JSON either way, redacted by default.
# LOG_LEVEL=info

# Ceiling on how much of a failure's reason — the full cause chain, innermost first —
# one log line quotes. Bounded because a database driver quotes the statement it
# refused, and a batched statement is thousands of characters long.
# LOG_REASON_MAX_CHARS=200

# Honor X-Forwarded-For / X-Forwarded-Proto. Set true ONLY behind a proxy you
# control — otherwise any client can forge its own IP past the rate limiter.
# TRUST_PROXY=false

# === Observability ===
# Which commit this build is, reported by router_build_info{revision} and the boot
# log. The released image bakes in the tagged commit's sha; anything else says
# `unknown`, which is the honest answer. Set it by hand only when you build your own
# image and want it to name its own source.
# ROUTER_REVISION=

# GlitchTip (Sentry-protocol) error tracking. Unset = off, which is the default for
# dev, test and CI. In production set this to the DSN GlitchTip shows on the router's
# project (https://<key>@glitchtip.infra.developerz.ai/<n>); 5xx errors then ship
# there. Every event is scrubbed by the same redactor the structured logs use before
# it leaves the process — see observability/sentry.ts. Tracing and the request/fetch
# instrumentations are off, so the SDK never touches the request happy path.
# SENTRY_DSN=

# Logical environment tagged on every event; GlitchTip groups and filters on it.
# Defaults to "production"; override for a staging or dev install that also has a DSN.
# SENTRY_ENVIRONMENT=

# Bearer token GET /metrics demands: `Authorization: Bearer <token>`. Leave unset to
# leave the endpoint open, which is right only when its port is not routable from
# outside the host. /metrics exposes account, key and pool ids — never a credential.
# METRICS_TOKEN=

# Bearer token that authenticates the admin API without a browser login:
# `Authorization: Bearer <token>` against any /api/admin/** route. This is what lets a
# deploy script, a CI job, or an agent drive the same REST API the console drives —
# the console itself keeps using the cookie session and never sees this value.
#
# Leave it unset and the admin plane stays browser-only, which is the default.
#
# Boot refuses a token shorter than 32 characters: unlike the login form, nothing
# rate-limits this credential, so its length is the only thing bounding a guessing
# attack. It also refuses one starting `mar_live_` — that prefix marks a data-plane
# router key, which the admin guard rejects outright, so such a token would
# authenticate nothing while looking correct.
#
# Generate one:  openssl rand -base64 36 | tr -d '=+/'
# Rotate it by changing this value and restarting; there is no revoke call, because
# there is no session to end.
# ADMIN_API_TOKEN=

# === Credential sweep + idle-account keepalive ===
# Two halves, one daily tick.
#
# FREE: `claude auth status` is asked of EVERY Claude subscription account, idle or
# not — it reads the credential file and contacts nobody. An expired subscription is
# marked `needs_reauth` within a day instead of on the next client's failed request.
#
# BILLED: a Claude subscription's ACCESS token is refreshed by the Agent SDK only when
# it runs, so an account nobody routes to fails its first request after a long
# silence. This half spends ONE REAL, BILLED REQUEST on an account that has gone
# unused, and skips one the free check already found logged out.
#
# What neither half can do: a Claude subscription's REFRESH token hard-expires about
# 30 days after login no matter how much it is used (verified in production). No
# request, probe, or timer moves that date — only reconnecting the account from
# /accounts does. Plan on a monthly reconnect per subscription.
#
# Cost is bounded by the THRESHOLD, not the interval: testing an account counts as
# using it, so each account is touched about once per idle window, not once per tick.
#
# How often the sweep runs. Every 6 hours, not daily: a subscription's access token
# lives ~8 hours, so a daily sweep wakes up long after a credential has gone cold and
# cannot keep one warm. The first tick after a restart is measured from the sweep's last
# recorded run, so a pod that restarts often no longer skips it entirely.
# IDLE_ACCOUNT_PROBE_INTERVAL_MINUTES=360
# How long unused is too long before the billed half spends a request.
# IDLE_ACCOUNT_AFTER_DAYS=7
# Accounts probed per tick. Small on purpose — each may spawn a ~245 MB `claude`
# subprocess and bill a turn. The sweep is resumable, so a backlog drains over ticks.
# IDLE_ACCOUNT_PROBE_BATCH_SIZE=5
# Whether the sweep may spend a real, BILLED turn on an idle account at all. Off by
# default: checking whether a subscription is alive must never spend usage, and a turn
# cannot move the refresh-token cliff anyway. The free daily `claude auth status` check
# and the turn-free usage gauge run regardless.
# IDLE_ACCOUNT_PROBE_PAID_TURN=false

# --- Model catalog refresh ---
# Asks each account's upstream what models it serves, and stores the answer with
# each model's context window — which is what `GET /v1/catalog` renders.
#
# Free, unlike the keepalive above: a model listing costs no tokens and spends no
# quota window, which is why it can run hourly.
#
# It writes ONLY the catalog table. `supported_models` — the column that decides
# which accounts a request may land on — stays yours and is never touched by this
# timer, so an upstream retiring a model changes what the listing says and never
# where a request goes.
#
# Skipped for Claude subscriptions (no listing endpoint — the Agent SDK owns that
# catalog), for `openrouter` (an aggregator of several hundred models it does not
# itself serve), and for accounts you disabled.
# MODEL_CATALOG_REFRESH_INTERVAL_MINUTES=60
# Accounts refreshed per tick, oldest catalog first. A fleet larger than one batch
# rotates through across consecutive ticks rather than refreshing the same few.
# MODEL_CATALOG_REFRESH_BATCH_SIZE=25

# === Claude subscriptions (Agent SDK) ===
# Parent directory holding one CLAUDE_CONFIG_DIR per Claude subscription Account
# (spec §11). The router names each one `<CLAUDE_CONFIG_ROOT>/<account id>` and
# creates it 0700 with the Account; there is nothing per-account to configure.
# Must be absolute, and must sit on the persistent `claude-config` volume from
# docker-compose.yml — these directories hold live subscription credentials and
# are NOT covered by ENCRYPTION_KEY. Treat the volume as secret material.
# A root at or under this host's own ~/.claude is refused at boot: a
# CLAUDE_CONFIG_DIR there changes the credential lookup key and breaks OAuth.
# CLAUDE_CONFIG_ROOT=/data/claude

# Pins the `claude` binary the Agent SDK spawns. Leave unset: the router resolves it
# itself (bundled binary → SDK platform package → PATH → native-installer path) and
# /readyz reports which rung won. Set this only to override that, e.g. to test a
# specific build — and note that a set-but-unusable path FAILS rather than falling
# back, so the router never silently spawns a binary you did not name.
# CLAUDE_CLI_PATH=

# How many `claude` subprocesses may run at once on this replica. Every subscription
# request spawns one (a ~200 MB native binary), so this is a MEMORY bound, not a
# throughput one — size it against the container's RAM, not its CPUs. Requests over
# the ceiling queue rather than fail.
# CLAUDE_SDK_MAX_CONCURRENCY=10

# The same ceiling for any single Claude subscription Account. This is what stops one
# account's burst from starving every other account in the pool. Values above
# CLAUDE_SDK_MAX_CONCURRENCY are legal and simply never bind.
# CLAUDE_SDK_MAX_CONCURRENCY_PER_ACCOUNT=4

# The refresh-window guard. A Claude subscription's access token lives ~8 hours, and the
# refresh token ROTATES when it is spent — so two `claude` subprocesses crossing that
# moment against one account both present the same token, the second is rejected, and the
# losing CLI blanks the credential file. That permanently deauthenticates the account
# (it cost three of six accounts in one day before this existed).
#
# Inside this many seconds of expiry, only one subprocess per account may cross. The first
# is not delayed and refreshes as part of its own work; the rest wait for the file to show
# the new token. Outside the window this is one cached read and no wait.
# CLAUDE_SDK_CREDENTIAL_REFRESH_SKEW_SECONDS=300

# The credential keepalive. A subscription's access token lives ~8 hours and ONLY A REAL
# TURN refreshes it — the turn-free handshake behind the model-catalog sweep and the usage
# gauge leaves .credentials.json untouched. So an account nothing routes to goes cold, and
# the next thing to touch it finds a refresh the upstream will not honour, after which the
# CLI blanks the credential and only an interactive re-login recovers it.
#
# On by default: any logged-in subscription within the margin below gets one small turn to
# refresh. That spends a little usage, deliberately. `false` logs the cold credential and
# warms nothing.
# CLAUDE_SDK_CREDENTIAL_KEEPALIVE=true

# How much margin before expiry counts as cold. Defaults to one sweep interval plus 30
# minutes, DERIVED rather than fixed: a margin narrower than the gap between sweeps leaves
# a token that expires between two ticks unwarmed by either. 0 waits until it has actually
# expired.
# CLAUDE_SDK_CREDENTIAL_KEEPALIVE_BEFORE_MINUTES=390

# How long a waiter gives that first subprocess before proceeding anyway. A wedged account
# would be a worse outage than the race, so this gate always fails open — loudly.
# CLAUDE_SDK_CREDENTIAL_REFRESH_WAIT_MS=20000

# How often a waiter re-reads the credential file while it waits.
# CLAUDE_SDK_CREDENTIAL_REFRESH_POLL_MS=250

# The usage gauge: a Claude subscription's plan-usage percentages (5-hour, 7-day,
# per-model), read through the Agent SDK's own query object once a turn has started
# answering, and once per account on the daily sweep through a turn-free query.
# Never on the response path, never a turn of its own, never a token touched
# (docs/idea/11-anthropic-agent-sdk.md §5). false leaves the console showing alarms only.
# CLAUDE_SDK_USAGE_GAUGE=true
# The most one reading may take before it is dropped. A dropped reading costs freshness only.
# CLAUDE_SDK_USAGE_GAUGE_TIMEOUT_MS=5000
# At most one reading per account per interval, so parallel agents on one subscription
# ask the usage endpoint once. 0 asks on every turn.
# CLAUDE_SDK_USAGE_GAUGE_MIN_INTERVAL_SECONDS=60

# Minimum seconds between manual "Re-check now" probes of the same account. The
# button re-queries the provider's live quota signal; the cooldown is what stops
# it from being used to hammer an upstream.
# 0 is legal and means no cooldown.
# ACCOUNT_RECHECK_COOLDOWN_SECONDS=60

# Minimum seconds between manual "Test now" presses of the same account. Distinct
# from the re-check cooldown above: this one sends a real, billed completion (an
# Agent-SDK account spawns a subprocess and spends a turn), so it defaults higher.
# 0 is legal and means no cooldown.
# ACCOUNT_TEST_NOW_COOLDOWN_SECONDS=120

# How long the admin accounts read trusts one reading of a Claude subscription's
# credential METADATA (login expiry, plan, tier — never the token) before re-reading
# the file. Keeps a console poll from stat-ing six files a second. 0 re-reads every time.
# ADMIN_CREDENTIAL_METADATA_TTL_SECONDS=60

# === Retention / janitor (see docs/idea/09-deployment.md#cleanups--retention) ===
# Idle sticky-session and fingerprint TTL, in hours.
# RETENTION_SESSIONS_HOURS=24

# Raw usage records kept this many days, then rolled up to daily aggregates.
# RETENTION_USAGE_DAYS=90

# Daily aggregates kept this many days — the long half of usage retention, one row per
# distinct (day, key, account, pool, model). Must be at least RETENTION_USAGE_DAYS, or boot
# refuses it: a shorter window deletes rolled days whose raw rows are still there, and the
# rollup writes them straight back on its next tick.
# RETENTION_USAGE_DAILY_DAYS=730

# Audit events kept this many days. They never contain secrets.
# RETENTION_AUDIT_DAYS=365

# Finished scheduled-task runs kept this many days. Six tasks ticking as often as every five
# minutes write about a thousand rows a day between them. A run with no finish time is never
# swept however old it is — that row is the only evidence a task wedged.
# RETENTION_TASK_RUNS_DAYS=30

# Revoked or expired API keys are purged this many days after revocation, so
# historical usage stays joinable for a while.
# RETENTION_REVOKED_KEYS_DAYS=30

# TTL for one-shot OAuth state values and PKCE verifiers, in minutes.
# RETENTION_OAUTH_STATE_MINUTES=10

# Grace period before a CLAUDE_CONFIG_DIR under CLAUDE_CONFIG_ROOT that no account
# claims is removed. Those directories hold a subscription's OAuth credentials in
# cleartext, so an abandoned one is a credential nothing will ever rotate. A directory
# is created just before its account row is inserted, so this must comfortably exceed
# that gap: too short and the reaper deletes a login that was still being made.
# RETENTION_ORPHAN_CONFIG_DIR_HOURS=24

# How long an Agent-SDK session transcript — the `<session>.jsonl` (and `<session>/`
# directory) the `claude` CLI writes under an account's CLAUDE_CONFIG_DIR for --resume —
# is kept after its last turn. Same day as RETENTION_SESSIONS_HOURS by default, so the
# row that could resume a transcript and the file expire together. Shorter trades disk
# for a cold replay on a paused conversation's next turn; it never fails a request.
# RETENTION_SDK_TRANSCRIPT_HOURS=24

# Base sweep interval for the janitor. The actual interval is jittered around it so
# sweeps never pile onto request spikes or onto each other after a restart.
# JANITOR_INTERVAL_MINUTES=60

# === Scheduler task intervals ===
# Each interval is jittered around the configured value so sweeps never pile onto
# request spikes or onto each other after a restart.

# Usage record rollup interval, in minutes. Raw records older than RETENTION_USAGE_DAYS
# are summarized into daily aggregates.
# USAGE_ROLLUP_INTERVAL_MINUTES=60

# OAuth state (and PKCE verifier) purge interval, in minutes. One-shot values older
# than RETENTION_OAUTH_STATE_MINUTES are deleted.
# OAUTH_STATE_PURGE_INTERVAL_MINUTES=5

# Account quota floor probe interval, in minutes. Periodic refresh of cached quota state.
# QUOTA_FLOOR_INTERVAL_MINUTES=30

# Orphaned CLAUDE_CONFIG_DIR reap interval, in minutes. Hours rather than minutes: an
# orphan is a crash artifact, and how long one may linger is
# RETENTION_ORPHAN_CONFIG_DIR_HOURS, not this.
# CONFIG_DIR_REAP_INTERVAL_MINUTES=360

# Agent-SDK transcript sweep interval, in minutes. Hourly like the janitor; how long a
# transcript is kept is RETENTION_SDK_TRANSCRIPT_HOURS, not this.
# SDK_TRANSCRIPT_SWEEP_INTERVAL_MINUTES=60

# Admin console session purge interval, in minutes. Sweeps expired rows out of the
# admin_sessions table in bounded batches under the advisory lock, like every sweep.
# ADMIN_SESSION_PURGE_INTERVAL_MINUTES=30

# Max rows per bounded-delete sweep (usage, session, revoked keys, audit, OAuth state),
# directories per orphaned-config-dir reap, and sessions per Agent-SDK transcript sweep.
# Larger trades memory and latency for fewer sweeps; smaller means more passes.
# Refused at boot at 0, and not because it would delete nothing: a drain learns a
# category is caught up from a batch shorter than the limit, and nothing is shorter
# than zero, so the tick spins forever holding its Postgres advisory lock.
# SWEEP_BATCH_SIZE=1000

# Jitter applied to task intervals as a fraction of the interval. E.g., 0.2 means
# the actual interval varies ±20% around the base value, spreading load after a restart.
# 0 is legal and means: run every task exactly on its interval, unspread.
# SCHEDULER_JITTER_FRACTION=0.2

# === OAuth credential refresh ===
# Not a scheduler task and not a poll: every account the router holds an OAuth token
# for schedules its own refresh from its own expiry, and re-schedules each time a new
# token lands. Claude subscriptions are untouched by all three — the Agent SDK owns
# those tokens inside the account's CLAUDE_CONFIG_DIR.

# Share of a token's remaining lifetime allowed to elapse before refreshing. 0.75
# refreshes with a quarter of the lifetime still in hand. Must be between 0 and 1,
# exclusive: 0 would refresh in a loop, 1 would refresh at the instant of expiry.
# OAUTH_REFRESH_LEAD_FRACTION=0.75

# Floor on any refresh delay, in seconds, and the first step of the retry backoff.
# What stops an already-expired token from re-arming at zero and hammering the provider.
# OAUTH_REFRESH_MIN_DELAY_SECONDS=30

# Attempts against an unreachable token endpoint before the account is parked at
# needs_reauth and drops out of routing. A refused refresh is never retried — only a
# clock fixes an outage, and a revoked grant needs a human. Requests never fail because
# of this: they fail over to the next account in the pool.
# OAUTH_REFRESH_MAX_ATTEMPTS=5

# === Request path: warm caches and the off-path usage writer ===
# Every value here is a staleness or memory bound. Nothing on the request path
# queries Postgres, so these are what decide how quickly it learns about a change.

# How long the warm routing catalog (accounts, pools, membership) may lag a write
# made by ANOTHER replica. A write by this replica refreshes it immediately, so this
# bounds only the multi-replica case. Lower costs one small query more often.
# CATALOG_REFRESH_SECONDS=30

# Verified router keys held in memory. The ceiling is memory, not correctness —
# an evicted key costs one indexed lookup on its next request.
# KEY_CACHE_MAX=4096

# How long a successful key verification is reused. Revoking a key invalidates it
# immediately, so this is not the revocation delay — it is how stale a key's own
# limits and scope may be.
# KEY_CACHE_TTL_SECONDS=60

# How long a FAILED lookup is remembered. Short on purpose: this is what stops a
# flood of bad keys becoming a flood of queries, and a just-minted key must start
# working quickly.
# 0 is legal and means: do not cache a miss at all.
# KEY_CACHE_NEGATIVE_TTL_SECONDS=5

# Session -> Account bindings held in memory, plus their fingerprint aliases.
# Only Claude subscription accounts ever create one: an SDK session resumes on the
# account that minted it and nowhere else, so the binding is correctness, not a cache.
# SESSION_CACHE_MAX=4096

# How long a binding is reused before its row is re-read. It bounds only how long
# this replica may lag another one's rebind. The row itself never expires on a timer
# — SDK sessions live for weeks upstream and dropping the mapping forces a replay.
# SESSION_CACHE_TTL_SECONDS=300

# How long "this session has no binding" is remembered. This is what keeps plain
# HTTP traffic on a subscription-serving router from re-asking Postgres every request.
# 0 is legal and means: do not cache an absent binding at all.
# SESSION_CACHE_NEGATIVE_TTL_SECONDS=30

# UsageRecord rows held in memory before the writer sheds the OLDEST. Overflow
# degrades reporting and never applies backpressure to live requests.
# USAGE_QUEUE_MAX=10000

# Rows per insert. Larger means fewer round trips and a bigger loss if the process dies.
# Bounded 1..2520 and refused at boot outside it: a usage row costs 26 of the 65535 bind
# parameters Postgres allows per statement (65535 / 26 = 2520), so a larger batch is
# rejected by the server on every flush — forever, silently, with traffic unaffected.
# USAGE_BATCH_SIZE=200

# How often the queue is drained. Raising it widens the window in which a crash
# loses unwritten usage rows; it never affects request latency.
# USAGE_FLUSH_INTERVAL_MS=1000

# How often a sustained usage-write failure or queue overflow is allowed one log
# line. The failure mode is a flood by definition; one line per window carries the
# count since the last one. A trailing report covers a burst that stops mid-window.
# USAGE_LOG_REPORT_INTERVAL_MS=60000

# How often observed quota readings are persisted. Not a poll: a reading exists
# only after a response reported one. Raising it widens the window in which a
# crash loses the freshest reading, and how stale another replica's gauges are.
# QUOTA_WRITE_INTERVAL_MS=5000

# How often a standing block the breaker formed — exhausted, needs_reauth — is
# written through to accounts.status, so it survives a restart and the console
# can show it. A cooldown is never persisted: a clock recovers it. Routing is
# unaffected at any setting; only how quickly the row catches up.
# ACCOUNT_STATUS_WRITE_INTERVAL_MS=1000

# The largest request body the router will read, in bytes. Over it: 413, refused
# before any account is dialed and before the ceiling's worth of bytes has been
# buffered — a declared Content-Length over the limit is turned away unread.
# Raise it for agents that paste whole repositories into a prompt; lower it to
# bound the memory one in-flight request can cost. Default is 32 MiB.
# MAX_REQUEST_BODY_BYTES=33554432

# --- Failover and backoff ----------------------------------------------------
# How hard the router tries, and how long a failing account stays out. None of
# these can change the one rule that is correctness rather than tuning: an
# attempt is never retried after bytes are on the wire.

# Ceiling on the distinct accounts tried for one client request before the honest
# failure. Unset — the default — means the pool is the ceiling: the chain keeps
# walking while an untried candidate exists. Set this only to fail *faster* than
# your pool allows; it can lower the bound, never raise it.
# ROUTING_MAX_ATTEMPTS=3

# Consecutive 5xx or connection failures before an account's breaker trips.
# Lower reacts faster to a sick provider and is quicker to punish a blip.
# ROUTING_FAILURE_THRESHOLD=3

# First cooldown step, doubling per consecutive failure.
# ROUTING_BASE_BACKOFF_MS=1000

# Ceiling on that doubling, so a long outage does not park an account for hours.
# ROUTING_MAX_BACKOFF_MS=300000

# How long the one request admitted onto a recovering account holds it. When a
# cooldown expires the account earns exactly one probe; everyone else is told
# `429` with this instant until that probe reports, so the backlog that built up
# during the cooldown cannot stampede the account the moment it comes back. The
# chain releases the hold as soon as its attempt has a verdict, so this only
# governs a probe that never reports at all.
# ROUTING_HALF_OPEN_HOLD_MS=30000

# Retry-After (seconds) answered when every candidate is out for a
# clock-recoverable reason but no reset instant is known. A pause, not a
# countdown — nothing is scheduled to clear the condition.
# ROUTING_UNKNOWN_RESET_RETRY_AFTER_SECONDS=30

# What a request does when its session is bound to an account that is merely
# cooling down. `fail` (the default) answers 429 with a Retry-After and keeps
# the binding, so the conversation stays resumable on the account that owns it.
# `rebind` drops the binding and starts a fresh upstream session on another
# eligible account — served now instead of after the reset, at the cost of the
# prior turns the bound account still holds. Only useful with more than one
# account the key can reach, and only for clients that resend full history.
# ROUTING_BOUND_ACCOUNT_COOLING_DOWN=fail

# How long the router waits on one upstream. Long by default, because a long
# completion is a normal response and not a hung one.
# UPSTREAM_TIMEOUT_MS=600000

# --- Translation -------------------------------------------------------------

# The `max_tokens` an Anthropic account is given when the client spoke a dialect
# that makes it optional and did not send one. Anthropic requires the field, so a
# ceiling has to come from somewhere; the default is deliberately generous,
# because a low value truncates answers nobody asked to truncate.
# TRANSLATE_DEFAULT_MAX_TOKENS=4096
