#!/bin/sh
# Live check against a deployed router: text, forced tool, tool_choice any, the tool-result round
# trip, a streamed forced tool, reasoning plus a forced tool, plus two informational legs on the
# other two ingress dialects. Reads the API key from the named environment variable only; never
# from argv, never printed.
#
#   bin/smoke --url https://router.example.com --model claude-opus-5 --key-env MAR_KEY
#   bin/smoke --help
#
# Exit codes:
#   0  every required leg PASS
#   1  at least one required leg FAIL
#   2  no FAIL, but at least one required leg INCONCLUSIVE
#  64  usage error (unknown flag, missing value, --help not the request)
set -eu

cd "$(dirname "$0")/.."

exec bun apps/api/smoke/run.ts "$@"