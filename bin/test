#!/bin/sh
# Run the test suite; any extra args are passed straight to `bun test`.
set -eu

cd "$(dirname "$0")/.."

# Exclude tmp/ — the cloned upstream repos we read for provider research. They
# ship thousands of their own tests that fail here (missing deps, DOM globals we
# don't configure) and would drown ours. tmp/ is gitignored, but `bun test` does
# not read .gitignore, so the exclusion has to be explicit.
#
# This is --path-ignore-patterns rather than a `bun test apps packages` filter
# because positional args are treated as substring filters, not directories:
# "apps" also matches tmp/opencode/packages/app/**, which is exactly the thing
# being excluded.
#
# An explicit argument still works: `bin/test apps/api`, `bin/test --watch`.

# The suites that need a real Postgres gate themselves on DATABASE_URL, and
# `bun test` folds their skips into the same green summary as a pass — a run
# that proved less looks exactly like a run that proved more. Say what was not
# covered instead, printed after the summary it is correcting so it cannot
# scroll away. A bare `bin/test` still runs, since it is the loop you use on a
# laptop with no Docker, but it stops implying it covered the database.
#
# Refusing is not this script's job. CI and `bin/check` both promise a database,
# and that promise is enforced from inside the run, where `process.env` is the
# same one the suites read (apps/api/test/support/database-gate.ts). Doing it
# here as well would be a second, weaker copy of the same rule.
#
# `bin/lib/database-url` reproduces `bun test`'s dotenv resolution — which is not
# a plain `bun` run's — so this warning names the value the run below actually
# used, not a different file's.
database_url="$(bin/lib/database-url)"

skipped_suites() {
  # Derived, never a hand-kept list: a new DB-gated file is named here the day
  # it is written, and a deleted one stops being claimed.
  #
  # Both conditions, because reading the variable is not the same as skipping on
  # it — the suite that tests this gate mentions DATABASE_URL on nearly every
  # line and always runs. Naming a file that did not skip is the same failure as
  # staying quiet about one that did: either way the list stops being believed.
  grep -rl 'process\.env\.DATABASE_URL' apps/*/test packages/*/test 2>/dev/null |
    while IFS= read -r file; do
      if grep -q 'skipIf' "$file"; then printf '%s\n' "$file"; fi
    done | sort
}

status=0
bun test --path-ignore-patterns='**/tmp/**' "$@" || status=$?

# Only when nothing promised a database. If something did, the run refused before
# its first test file and already said why — and claiming these suites "skipped"
# would be a second, wrong story: no suite ran at all.
if [ -z "$database_url" ] && [ -z "${CI:-}" ] && [ "${ROUTER_TEST_REQUIRE_DATABASE:-}" != "1" ]; then
  printf '\n\033[0;33m⚠  DATABASE_URL is unset — these suites SKIPPED, they did not pass:\033[0m\n' >&2
  skipped_suites | sed 's/^/     /' >&2
  printf '   Migrations, advisory-lock contention, retention deletes and the readiness\n' >&2
  printf '   probe are unproven by this run. Give it a database with: bin/setup\n\n' >&2
fi

exit "$status"
