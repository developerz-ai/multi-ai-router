#!/bin/sh
# Run the test suite.
#
#   bin/test                       the whole suite, as parallel shards (see below)
#   bin/test <pattern> [flags…]    anything else goes straight to one `bun test`
#   bin/test --changed             only the test files affected by what you changed (git); takes a
#                                  base too: `bin/test --changed=origin/main`
#   bin/test --watch               …and every other `bun test` flag, unchanged
#
# Environment:
#   ROUTER_TEST_SHARDS=N    how many shards a bare `bin/test` runs (default 2; 1 = one process)
#   ROUTER_TEST_VERBOSE=1   print every passing test, even when no terminal is attached
#
# OUTPUT. On a terminal, or in CI, every test is printed as before. Anywhere else — a pipe, a file,
# an agent reading the result — only failures and the summary are (`bun test --only-failures`): a
# green run of this suite is thirteen thousand lines, and the three that matter are at the bottom.
#
# SHARDS. A bare `bin/test` splits the files across N `bun test --shard=k/N` processes that run at
# the same time, balanced by the per-file durations in bin/lib/test-timings.json. Each shard after
# the first gets its own database on the same server (`router_shard2`, created on demand by
# bin/lib/ensure-test-database.ts and stamped as bin/test's own; one it did not create is refused),
# because the live-Postgres suites own the database they are pointed at. Each shard's output is
# captured and printed whole when all have finished, in shard order, so two interleaved runs never
# have to be untangled; on a terminal, or with ROUTER_TEST_VERBOSE=1, it is also streamed while they
# run, so a stalled suite is visible as one. ANY shard failing fails the run.
#
# Refresh the timings after adding or reshaping slow suites — a normal sharded run that also
# rewrites bin/lib/test-timings.json from what it measured (commit the result):
#   ROUTER_TEST_UPDATE_TIMINGS=1 bin/test
set -eu

cd "$(dirname "$0")/.."

# Same runtime as CI and the image, or say so: a different bun runs these silently.
bin/lib/require-bun

# Native ownership tests must exercise the current C source, including on a fresh clone. Built once,
# here, before any shard starts: two shards compiling into the same path would race.
if [ "$(uname -s)" = Linux ]; then
  bin/build-cli-owner
else
  echo "Linux CLI ownership tests are unsupported on this host; use the router container." >&2
fi

# tmp/ (cloned upstream repos and their thousands of tests) is excluded by
# `pathIgnorePatterns` in bunfig.toml, so a raw `bun test` at the root honours it
# too.

# The suites that need a real Postgres gate themselves on DATABASE_URL, and
# `bun test` folds their skips into the same green summary as a pass — a run
# that proved less looks exactly like a run that proved more. Say what was not
# covered instead, printed after the summary it is correcting so it cannot
# scroll away. A bare `bin/test` still runs, since it is the loop you use on a
# laptop with no Docker, but it stops implying it covered the database.
#
# Refusing is not this script's job. CI and `bin/check` both promise a database,
# and that promise is enforced from inside the run, where `process.env` is the
# same one the suites read (apps/api/test/support/database-gate.ts). Doing it
# here as well would be a second, weaker copy of the same rule.
#
# `bin/lib/database-url` reproduces `bun test`'s dotenv resolution — which is not
# a plain `bun` run's — so this warning names the value the run below actually
# used, not a different file's.
database_url="$(bin/lib/database-url)"

skipped_suites() {
  # Derived, never a hand-kept list: a new DB-gated file is named here the day
  # it is written, and a deleted one stops being claimed.
  #
  # Both conditions, because reading the variable is not the same as skipping on
  # it — the suite that tests this gate mentions DATABASE_URL on nearly every
  # line and always runs. Naming a file that did not skip is the same failure as
  # staying quiet about one that did: either way the list stops being believed.
  grep -rl 'process\.env\.DATABASE_URL' apps/*/test packages/*/test 2>/dev/null |
    while IFS= read -r file; do
      if grep -q 'skipIf' "$file"; then printf '%s\n' "$file"; fi
    done | sort
}

quiet=""
if [ ! -t 1 ] && [ -z "${CI:-}" ] && [ "${ROUTER_TEST_VERBOSE:-}" != "1" ]; then
  quiet="--only-failures"
fi

# Stream the shards while they run when a person is watching: a terminal, or an explicit ask.
live=""
if [ -t 1 ] || [ "${ROUTER_TEST_VERBOSE:-}" = "1" ]; then live=1; fi

shards="${ROUTER_TEST_SHARDS:-2}"
case "$shards" in
  '' | *[!0-9]* | 0) echo "bin/test: ROUTER_TEST_SHARDS must be a positive integer, got '$shards'" >&2; exit 64 ;;
esac

timings="bin/lib/test-timings.json"

run_sharded() {
  logs="$(mktemp -d "${TMPDIR:-/tmp}/router-test.XXXXXX")"
  # shellcheck disable=SC2064  # expand now: the directory is this run's, not whatever $logs is later
  trap "rm -rf '$logs'" EXIT
  # A Ctrl-C must take the shards with it, not leave N suites running against the dev database.
  # The shards by pid, never `kill 0`: run from CI, `timeout`, or bin/check, this script shares its
  # caller's process group, and signalling the group would take the caller down with it.
  # Killed and then waited for: the caller (bin/check, CI) may start something on the same
  # database the moment this script exits, and a shard still shutting down would be in it.
  pids=""
  follower=""
  # shellcheck disable=SC2086  # one pid per word
  trap 'kill $pids $follower 2>/dev/null; wait $pids 2>/dev/null || true; exit 130' INT TERM

  shard=1
  while [ "$shard" -le "$shards" ]; do
    : >"$logs/$shard.log"
    shard=$((shard + 1))
  done
  # Live progress where someone is watching. The per-shard report below is still printed — the
  # follower is killed, not drained, so only that report is guaranteed to hold the last lines.
  if [ -n "$live" ]; then
    tail -n +1 -f "$logs"/*.log 2>/dev/null &
    follower=$!
  fi

  shard=1
  while [ "$shard" -le "$shards" ]; do
    (
      if [ -n "$database_url" ]; then
        # `|| exit 1`, spelled out: this function is called as `run_sharded || …`, where errexit is
        # off, and bash (macOS's /bin/sh) would carry on with an EMPTY DATABASE_URL — which outranks
        # .env, skips every live-Postgres suite, and exits green. A shard with no database fails.
        # On stdin, never as an argument: the URL carries a password, and argv is world-readable.
        #
        # In the background and waited for, not in a command substitution: a TERM to this subshell
        # (a type error stopping the run, a Ctrl-C) would otherwise end the subshell and leave the
        # helper running SQL after the script had reported and exited. Its answer comes back
        # through a file in this run's private directory.
        helper=""
        trap 'kill "$helper" 2>/dev/null; wait "$helper" 2>/dev/null || true; exit 143' INT TERM
        bun bin/lib/ensure-test-database.ts "$shard" >"$logs/$shard.url" <<EOF &
$database_url
EOF
        helper=$!
        wait "$helper" || {
          echo "bin/test: could not prepare shard $shard's database" >&2
          exit 1
        }
        trap - INT TERM
        DATABASE_URL="$(cat "$logs/$shard.url")"
        rm -f "$logs/$shard.url"
        [ -n "$DATABASE_URL" ] || { echo "bin/test: shard $shard got an empty DATABASE_URL" >&2; exit 1; }
        export DATABASE_URL
      fi
      if [ "${ROUTER_TEST_UPDATE_TIMINGS:-}" = "1" ]; then
        # `--update-timings` writes the FIRST file, and only this shard's files: a scratch file per
        # shard, merged below, so two shards never write the committed one at the same time.
        printf '{"version":1,"files":{}}' >"$logs/$shard.timings.json"
        # shellcheck disable=SC2086  # $quiet is one flag or nothing
        exec bun test --shard="$shard/$shards" --timings="$logs/$shard.timings.json" \
          --timings="$timings" --update-timings $quiet
      fi
      # shellcheck disable=SC2086  # $quiet is one flag or nothing
      exec bun test --shard="$shard/$shards" --timings="$timings" $quiet
    ) >"$logs/$shard.log" 2>&1 &
    pids="$pids $!"
    shard=$((shard + 1))
  done

  failed=""
  codes=""
  for pid in $pids; do
    code=0
    wait "$pid" || code=$?
    codes="$codes $code"
  done
  [ -z "$follower" ] || { kill "$follower" 2>/dev/null; wait "$follower" 2>/dev/null || true; }

  shard=1
  for code in $codes; do
    printf '\n── shard %s/%s — exit %s ──\n' "$shard" "$shards" "$code"
    # Streamed already: a passing shard repeats only its closing counts. A FAILED one is replayed
    # whole — the follower is killed, not drained, and whatever it had not yet shown when it died
    # would otherwise be the failure itself.
    if [ -n "$live" ] && [ "$code" -eq 0 ]; then tail -n 15 "$logs/$shard.log"; else cat "$logs/$shard.log"; fi
    [ "$code" -eq 0 ] || failed="$failed $shard"
    shard=$((shard + 1))
  done

  # Even after a failure: a red test still took the time it took, and the table is only a balance
  # hint. A shard that died before measuring anything leaves the committed table alone.
  if [ "${ROUTER_TEST_UPDATE_TIMINGS:-}" = "1" ]; then
    bun bin/lib/merge-test-timings.ts "$timings" "$logs"/*.timings.json ||
      echo "bin/test: timings not refreshed" >&2
  fi

  if [ -n "$failed" ]; then
    printf '\n\033[0;31m✘\033[0m  bin/test: shard(s)%s of %s failed — the failures are listed under each shard above.\n' "$failed" "$shards" >&2
    return 1
  fi
  printf '\n\033[0;32m✔\033[0m  bin/test: all %s shards passed.\n' "$shards"
}

status=0
if [ "$#" -eq 0 ] && [ "$shards" -gt 1 ]; then
  run_sharded || status=$?
else
  # In the background and waited for, with its stdin kept: a shell runs no trap while a foreground
  # child is alive, and dies on a TERM it has no trap for — leaving `bun test` running against the
  # database with nobody waiting on it. This way a signal stops the run and reaps it.
  # shellcheck disable=SC2086  # $quiet is one flag or nothing
  bun test $quiet "$@" <&0 &
  single=$!
  trap 'kill "$single" 2>/dev/null; wait "$single" 2>/dev/null || true; exit 130' INT TERM
  wait "$single" || status=$?
  trap - INT TERM
fi

# Only when nothing promised a database. If something did, the run refused before
# its first test file and already said why — and claiming these suites "skipped"
# would be a second, wrong story: no suite ran at all.
if [ -z "$database_url" ] && [ -z "${CI:-}" ] && [ "${ROUTER_TEST_REQUIRE_DATABASE:-}" != "1" ]; then
  printf '\n\033[0;33m⚠  DATABASE_URL is unset — these suites SKIPPED, they did not pass:\033[0m\n' >&2
  skipped_suites | sed 's/^/     /' >&2
  printf '   Migrations, advisory-lock contention, retention deletes and the readiness\n' >&2
  printf '   probe are unproven by this run. Give it a database with: bin/setup\n\n' >&2
fi

exit "$status"
