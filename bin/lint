#!/bin/sh
# Lint + format check (Biome) and type check (tsc), the same way CI runs them.
set -eu

cd "$(dirname "$0")/.."

# Same runtime as CI and the image, or say so: a different bun runs these silently.
bin/lib/require-bun

# Read-only: no --write. `bin/fmt` is the writing counterpart.
bun run lint

# Bun never type-checks at runtime and Biome does not either, so tsc is the only
# thing enforcing the strict/no-`any` rule — tests, bench and tooling included.
# Same script as CI's typecheck job.
bun run typecheck
