#!/usr/bin/env bash
# Shortcuts against the local dev database (docker-compose.dev.yml).
#
#   bin/db psql          interactive shell
#   bin/db migrate       apply pending migrations
#   bin/db generate      author a migration from the current schema
#   bin/db check         verify the migration journal is consistent (drizzle-kit check)
#   bin/db reset         DESTROY the dev data and re-migrate from scratch
#   bin/db url           print the DATABASE_URL these commands use
#
# The port is the one bin/setup was given (DEV_DB_PORT, recorded in .env).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# shellcheck source=bin/lib/dev-db-env
. bin/lib/dev-db-env
DEV_DB_PORT="$(dev_db_port)"
export DEV_DB_PORT
DEV_URL="$(dev_db_url "$DEV_DB_PORT")"
COMPOSE="$DEV_DB_COMPOSE"

case "${1:-}" in
  psql)
    shift
    exec $COMPOSE exec postgres psql -U router -d router "$@"
    ;;
  migrate)
    exec env DATABASE_URL="$DEV_URL" bun run --cwd packages/db migrate
    ;;
  generate)
    # Deliberately no DATABASE_URL: `generate` only reads ./src/schema and must
    # work with no database running. See packages/db/drizzle.config.ts.
    exec bun run --cwd packages/db db:generate
    ;;
  check)
    # Offline like `generate`: reads the migrations folder and its journal only.
    exec bun run --cwd packages/db db:check
    ;;
  reset)
    # Guarded because it is unrecoverable. Only ever points at the dev compose
    # volume — it cannot reach a deployed database.
    printf 'This DESTROYS the local dev database and its volume. Type "reset" to confirm: '
    read -r confirm
    [ "$confirm" = "reset" ] || { echo "aborted"; exit 1; }
    $COMPOSE down -v
    $COMPOSE up -d
    dev_db_wait || { echo "postgres did not become ready — check: $COMPOSE logs postgres" >&2; exit 1; }
    env DATABASE_URL="$DEV_URL" bun run --cwd packages/db migrate
    echo "dev database reset."
    ;;
  url)
    echo "$DEV_URL"
    ;;
  *)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
