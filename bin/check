#!/bin/sh
# The gate: lint, typecheck, test, build — the four offline CI jobs, in order.
#
# Not the whole CI gate. CI also gates on the `advisory` job (it needs the
# network, to reach OSV.dev) and the `ui-geometry` job (it needs a browser, for
# the headless layout check) — neither belongs in a local gate, so both stay
# in CI. The `bench` job is a report (job-level `continue-on-error`): it never
# fails the build.
#
# Run this before committing. If it passes here the offline jobs pass on the PR
# too; if it fails here you have the failure locally with a fast loop, instead
# of a red run and a five-minute round trip.
set -eu

cd "$(dirname "$0")/.."

bin/lib/require-bun

die() { printf '\033[0;31m✘\033[0m  %s\n' "$*" >&2; exit 1; }

# "If it passes here it passes on the PR" is only true when this run covers what
# CI covers. CI gives the test job a real Postgres service container, so the
# DB-backed suites — migrations, advisory-lock contention, retention deletes,
# the readiness probe — always execute there. With DATABASE_URL unset they skip
# themselves instead, and `bun test` reports a skip inside the same green
# summary as a pass: the gate would go green having proved strictly less than
# the PR will. That silence is the bug, so refuse rather than shrink the gate.
#
# Declaring it here is what makes the refusal real. The test run reads this and
# stops itself before the first file if it has no database
# (apps/api/test/support/database-gate.ts), reading the same process.env the
# suites read — so no dotenv rule, and no future change to one, can put this gate
# and the run it guards on different answers.
export ROUTER_TEST_REQUIRE_DATABASE=1

# The same question asked early, so the refusal lands in a second instead of
# after `bun install`, lint and typecheck. Advisory only: `bin/lib/database-url`
# emulates Bun's dotenv rules, and an emulation is exactly what must not be the
# last word here — the run itself is.
if [ -z "$(bin/lib/database-url)" ]; then
  die "DATABASE_URL is not set — the live-Postgres suites would skip and this gate
    would pass on less than CI runs. Give it a database:

      bin/setup                     starts the dev Postgres and writes DATABASE_URL to .env
      DATABASE_URL=… bin/check      point at a Postgres 16+ you already run

    \`bun test\` reads .env / .env.test and ignores .env.local: a URL set only in
    .env.local, or blanked in .env.test, is not the one this run would use."
fi

# Same flag CI uses, so a stale lockfile fails here rather than on the PR.
bun install --frozen-lockfile

# Sequential and fail-fast (set -e): stop at the first broken gate, exactly like
# reading those four CI jobs top to bottom (lint, typecheck, test, build).
bin/lint
bin/test
bun run build
