#!/bin/sh
# The gate: lint, typecheck, test, build — the four offline CI jobs.
#
#   bin/check             the gate
#   bin/check --fast      NOT the gate: lint, typecheck and only the tests your changes affect
#                         (`bin/test --changed=origin/main`), no build. The inner loop while
#                         working; a commit still wants the plain `bin/check`.
#   bin/check --verbose   every stage's full output, live: the suite streams as it runs (every
#                         passing test included) and typecheck prints the moment it finishes
#
# OUTPUT. One line per stage — its name, its verdict, how long it took — and nothing else when the
# stage passed. A stage that fails prints its own output in full (the test stage's is already only
# the failures) and the gate stops. So the last screen of a red run is the reason it is red.
#
# Not the whole CI gate. CI also runs `ui-geometry` (it needs a browser, for the
# headless layout check; a required check), `image` (it needs Docker, to build
# the release Dockerfile) and `advisory` (it needs the network, to reach
# OSV.dev; it gates main's colour and every release, not a merge) — none belongs
# in a local gate, so they stay in CI. The `bench` job is a report (job-level
# `continue-on-error`).
#
# Run this before committing. If it passes here the offline jobs pass on the PR
# too; if it fails here you have the failure locally with a fast loop, instead
# of a red run and a five-minute round trip.
set -eu

cd "$(dirname "$0")/.."

fast=""
verbose=""
for argument in "$@"; do
  case "$argument" in
    --fast) fast=1 ;;
    --verbose) verbose=1 ;;
    *) echo "usage: bin/check [--fast] [--verbose]" >&2; exit 64 ;;
  esac
done

bin/lib/require-bun

die() { printf '\033[0;31m✘\033[0m  %s\n' "$*" >&2; exit 1; }

# "If it passes here it passes on the PR" is only true when this run covers what
# CI covers. CI gives the test job a real Postgres service container, so the
# DB-backed suites — migrations, advisory-lock contention, retention deletes,
# the readiness probe — always execute there. With DATABASE_URL unset they skip
# themselves instead, and `bun test` reports a skip inside the same green
# summary as a pass: the gate would go green having proved strictly less than
# the PR will. That silence is the bug, so refuse rather than shrink the gate.
#
# Declaring it here is what makes the refusal real. The test run reads this and
# stops itself before the first file if it has no database
# (apps/api/test/support/database-gate.ts), reading the same process.env the
# suites read — so no dotenv rule, and no future change to one, can put this gate
# and the run it guards on different answers.
export ROUTER_TEST_REQUIRE_DATABASE=1

# The same question asked early, so the refusal lands in a second instead of
# after `bun install`, lint and typecheck. Advisory only: `bin/lib/database-url`
# emulates Bun's dotenv rules, and an emulation is exactly what must not be the
# last word here — the run itself is.
if [ -z "$(bin/lib/database-url)" ]; then
  die "DATABASE_URL is not set — the live-Postgres suites would skip and this gate
    would pass on less than CI runs. Give it a database:

      bin/setup                     starts the dev Postgres and writes DATABASE_URL to .env
      DATABASE_URL=… bin/check      point at a Postgres you already run (CI tests 18)

    \`bun test\` reads .env / .env.test and ignores .env.local: a URL set only in
    .env.local, or blanked in .env.test, is not the one this run would use."
fi

logs="$(mktemp -d "${TMPDIR:-/tmp}/router-check.XXXXXX")"
trap 'rm -rf "$logs"' EXIT
# The children by pid, never `kill 0`: run under CI, `timeout` or an agent's tool runner this script
# shares its caller's process group, and signalling the group would signal the caller too.
typecheck_pid=""
test_pid=""
# Killed and then waited for, so nothing of this run is still on the database when it exits.
# shellcheck disable=SC2086  # each is one pid or empty
trap 'kill $typecheck_pid $test_pid 2>/dev/null; wait $typecheck_pid $test_pid 2>/dev/null || true; exit 130' INT TERM

seconds_since() { echo $(($(date +%s) - $1)); }

passed() { printf '\033[0;32m✔\033[0m  %-10s %ss\n' "$1" "$2"; }

# The stage's own output, then the one line that says which stage it was: an agent reading the tail
# of this run gets the failures and the verdict without scrolling.
failed() {
  [ -n "$verbose" ] || cat "$logs/$1.log"
  printf '\033[0;31m✘\033[0m  %-10s %ss — bin/check stopped here; the output above is that stage.\n' "$1" "$2" >&2
  exit 1
}

# stage <name> <command…>: run it, keep its output unless it fails or --verbose asked for it.
stage() {
  name="$1"
  shift
  started=$(date +%s)
  if [ -n "$verbose" ]; then
    printf '\n▸ %s\n' "$name"
    "$@" || failed "$name" "$(seconds_since "$started")"
  else
    "$@" >"$logs/$name.log" 2>&1 || failed "$name" "$(seconds_since "$started")"
  fi
  passed "$name" "$(seconds_since "$started")"
}

# Same flag CI uses, so a stale lockfile fails here rather than on the PR.
stage install bun install --frozen-lockfile

# Cheapest first: a formatting slip stops the gate in a second, not after the suite.
# Read-only, the same script as CI's lint job; `bin/fmt` is the writing counterpart.
stage lint bun run lint

# Typecheck and the suite share nothing — tsc reads the sources, the suite runs them — so they run
# at the same time and the gate costs max(typecheck, test) instead of their sum. Same script as CI's
# typecheck job.
#
# The suite first, in the background and waited for, so a signal reaches the trap above while it
# runs (a shell runs no trap until its foreground child returns). --verbose hands it the terminal
# and asks it to stream; otherwise its output is kept for the failure report.
test_started=$(date +%s)
test_status=0
if [ -n "$fast" ]; then
  # Only the test files git says the change reaches, in one process. Proves less than the gate, on
  # purpose — and says so at the end.
  set -- --changed="${CHECK_FAST_BASE:-origin/main}"
else
  set --
fi
if [ -n "$verbose" ]; then
  printf '\n▸ test (typecheck runs beside it and prints when it finishes)\n'
  ROUTER_TEST_VERBOSE=1 bin/test "$@" &
else
  bin/test "$@" >"$logs/test.log" 2>&1 &
fi
test_pid=$!

# Typecheck beside it, in a subshell that acts on its own verdict the moment it has one: a type
# error known in ten seconds should not wait two minutes for the suite to finish before it is
# reported. On failure it stops the suite — bin/test's own trap stops and reaps its shards — and
# the wait below returns at once. Its status crosses back through a file; a subshell cannot set a
# variable here.
typecheck_started=$(date +%s)
(
  compiler=""
  trap 'kill "$compiler" 2>/dev/null; wait "$compiler" 2>/dev/null || true; exit 143' INT TERM
  bun run typecheck >"$logs/typecheck.log" 2>&1 &
  compiler=$!
  code=0
  wait "$compiler" || code=$?
  echo "$code" >"$logs/typecheck.status"
  [ -z "$verbose" ] || { printf '\n▸ typecheck — exit %s\n' "$code"; cat "$logs/typecheck.log"; }
  [ "$code" -eq 0 ] || kill "$test_pid" 2>/dev/null
) &
typecheck_pid=$!

wait "$test_pid" || test_status=$?
test_pid=""
test_seconds="$(seconds_since "$test_started")"

wait "$typecheck_pid" || true
typecheck_pid=""
typecheck_status="$(cat "$logs/typecheck.status" 2>/dev/null || echo 1)"

# Typecheck's verdict is read first: when it failed, the suite's exit is only the echo of being
# stopped, and the type errors are the finding.
if [ "$typecheck_status" -ne 0 ]; then
  # --verbose already printed the log when the compiler exited; `failed` prints it otherwise.
  failed typecheck "$(seconds_since "$typecheck_started")"
fi
passed typecheck "$(seconds_since "$typecheck_started")"
[ "$test_status" -eq 0 ] || failed test "$test_seconds"
passed test "$test_seconds"

if [ -n "$fast" ]; then
  printf '\n\033[0;33m⚠\033[0m  bin/check --fast passed. It is NOT the gate: it ran only the tests affected by the\n'
  printf '   change and built nothing. Run bin/check before committing.\n'
  exit 0
fi

# Last, and alone: it rewrites dist/ and the native helper, which the suite reads.
stage build bun run build

printf '\n\033[0;32m✔\033[0m  bin/check passed — lint, typecheck, test, build.\n'
