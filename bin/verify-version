#!/bin/sh
# Prove the version this tree reports is the version everything calls it.
#
#   bin/verify-version           check the tree agrees with itself
#   bin/verify-version v1.2.3    …and that the tag names that same version
#
# Run it before cutting a tag; .github/workflows/release.yml runs it on every
# `v*` push, before a single layer is built.
#
# WHY THIS IS NOT `jq -r .version package.json` INLINE IN THE WORKFLOW: the
# version an operator sees at runtime — /healthz, router_build_info, the boot
# log, the console footer — comes from packages/core/src/version.ts, NOT from a
# manifest. A gate that reads package.json and stops is checking the copy, not
# the source, and there is nothing in the release path to catch the difference:
# release.yml builds and pushes, it never runs the test suite, so the drift test
# that normally holds VERSION and the manifests together
# (packages/core/test/unit/version.test.ts) does not gate a tag at all. Cut
# v1.0.1 from a tree where only the manifests were bumped and you publish an
# image whose /healthz says 1.0.0 — passing the old check, and wrong.
#
# So this checks the source, checks every manifest against it, checks the OCI
# `version` label the image carries against it, checks the changelog's release
# links, and checks the tag against the source. All five or nothing.
#
# Pure shell (jq, sed and grep, all present on any runner) rather than
# `bun test`: it runs before install, on a cold checkout, in about a second.
set -eu

cd "$(dirname "$0")/.."

die() { printf '\033[0;31m✘\033[0m  %s\n' "$*" >&2; exit 1; }

source_file="packages/core/src/version.ts"
[ -f "$source_file" ] || die "$source_file is missing — nothing to verify against"

# The single quoted string on the `export const VERSION = "…"` line. Anchored to
# the declaration so a version quoted in the doc comment above it cannot match.
version=$(sed -n 's/^export const VERSION = "\([^"]*\)".*/\1/p' "$source_file")
[ -n "$version" ] || die "no VERSION constant found in $source_file"

# Same shape the drift test asserts: X.Y.Z, optionally with a pre-release suffix
# (1.3.0-rc.1), and never the placeholder a never-released workspace carries.
[ "$version" != "0.0.0" ] || die "VERSION is still the unreleased placeholder 0.0.0"

# Build metadata (`+sha`) is deliberately NOT accepted even though semver allows
# it: `+` is illegal in a container tag, so a version carrying one produces a
# release whose image cannot be named. That belongs in `revision`, not here — and
# it gets its own message rather than reading as a typo.
case "$version" in
  *+*) die "VERSION carries build metadata no container tag can hold: $version" ;;
esac

# Semver 2.0.0 §2 and §9 in full, minus the build metadata refused above: three
# numeric core identifiers with no leading zeros, and — when there is a
# pre-release — dot-separated identifiers that are each non-empty, alphanumeric
# or hyphenated, and free of leading zeros when they are numeric.
#
# One regex rather than a ladder of shell globs, because the globs asked which
# characters appeared and never how they were arranged: `01.0.0`, `1.0.0-01` and
# `1.0.0-rc..1` all passed, and a gate that waves a malformed version through is
# a gate that lets one become a tag and an image name.
printf '%s\n' "$version" | grep -Eq \
  '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$' ||
  die "VERSION is not semver: $version"

# Every manifest the package manager sees: the root, plus one per workspace
# member. Discovered from the root `workspaces` globs, the same way the drift
# test does it, so a package added tomorrow is covered without editing this file.
manifests="package.json"
for pattern in $(jq -r '.workspaces // [] | .[]' package.json); do
  case "$pattern" in
    */*) ;;
    *) die "unsupported workspaces glob: $pattern" ;;
  esac
  for member in ${pattern%\*}*/; do
    [ -f "${member}package.json" ] || continue
    manifests="$manifests ${member}package.json"
  done
done

# A discovery bug would read as a pass — every manifest agreed, because none were
# found. Same reason the drift test asserts it found more than the root.
[ "$manifests" != "package.json" ] ||
  die "found no workspace manifests — check the \`workspaces\` globs in package.json"

for manifest in $manifests; do
  found=$(jq -r '.version' "$manifest")
  [ "$found" = "$version" ] ||
    die "$manifest says $found; $source_file says $version"
done

# One more copy, and the one nobody reads until they are holding an image they
# cannot place: the OCI `version` label baked into the runtime stage. It is what
# `docker inspect` answers without running the container, so an image whose label
# disagrees with its own /healthz is a provenance trap.
#
# release.yml overrides the label with the tag's semver (docker/metadata-action),
# which is exactly why the default has to be gated here — drift is invisible on a
# published image and shows up only on the local build nobody is checking.
#
# Required, never skipped: a gate that waves through a missing Dockerfile is a
# gate that reports a pass it did not earn.
dockerfile="Dockerfile"
[ -f "$dockerfile" ] || die "$dockerfile is missing — nothing to verify the image label against"

label=$(sed -n 's/.*org\.opencontainers\.image\.version="\([^"]*\)".*/\1/p' "$dockerfile")
[ -n "$label" ] || die "$dockerfile carries no org.opencontainers.image.version label"
[ "$label" = "$version" ] ||
  die "$dockerfile labels the image $label; $source_file says $version"

# The changelog is the release index a reader lands on, and 2.37.0–2.37.4 shipped
# with sections and pushed tags but no footer links — nothing noticed for five
# releases (#265). So: since 2.25.0, the start of the fully-linked era, every
# section must carry exactly one footer link, and the links must run in ascending
# order. Sections older than the floor predate the linked-footer convention and
# stay as history; the pinned floor is what keeps that exemption explicit instead
# of the gate silently passing whatever the links happen to stop at.
#
# Pre-release suffixes are tolerated in the patterns (an rc section must not
# false-positive) but the order and floor comparisons are numeric triples only.
changelog="CHANGELOG.md"
[ -f "$changelog" ] || die "$changelog is missing — nothing to verify the release links against"

link_base="https://github.com/developerz-ai/multi-ai-router/releases/tag/v"

headings=$(sed -nE 's/^## \[([0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?)\].*/\1/p' "$changelog")
linked=$(sed -nE "s|^\[([0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?)\]: ${link_base}\\1\$|\\1|p" "$changelog")

out_of_order=$(printf '%s\n' $linked | awk '
  function cmp(X, Y,   i) {
    for (i = 1; i <= 3; i++) {
      if (X[i] + 0 < Y[i] + 0) return -1
      if (X[i] + 0 > Y[i] + 0) return 1
    }
    return 0
  }
  NR == 1 { prev = $1; split($1, P, "."); next }
  {
    split($1, A, ".")
    # The violation is reported in the message below, off this string — awk itself
    # must still exit 0, or `set -e` aborts the script before die can name the pair.
    if (cmp(P, A) >= 0) { printf "%s then %s", prev, $1; exit }
    prev = $1
    split($1, P, ".")
  }
')
[ -z "$out_of_order" ] ||
  die "$changelog footer links must ascend: found $out_of_order"

linked_floor="2.25.0"
unlinked=$(printf '%s\n' $headings | awk -v floor="$linked_floor" -v base="$link_base" -v file="$changelog" '
  function geq(H,   F, i) {
    split(floor, F, ".")
    for (i = 1; i <= 3; i++) {
      if (H[i] + 0 > F[i] + 0) return 1
      if (H[i] + 0 < F[i] + 0) return 0
    }
    return 1
  }
  {
    split($1, H, ".")
    if (!geq(H)) next
    wanted = "[" $1 "]: " base $1
    count = 0
    while ((getline line < file) > 0) if (line == wanted) count++
    close(file)
    if (count != 1) printf " %s", $1
  }
')
[ -z "$unlinked" ] ||
  die "$changelog sections missing their footer link:$unlinked — every section since $linked_floor needs exactly one"

if [ $# -gt 0 ]; then
  # vX.Y.Z is the tag convention (release.yml triggers on `v*`); the published
  # image tags and this constant both drop the v.
  tag=${1#v}
  [ "$tag" = "$version" ] ||
    die "tag ${1} does not name version $version — bump $source_file and every manifest, or tag v$version"
fi

count=$(printf '%s\n' $manifests | wc -l | tr -d ' ')
printf '\033[0;32m✔\033[0m  version %s — %s manifests, image label%s\n' \
  "$version" "$count" "${1:+, tag $1}"
