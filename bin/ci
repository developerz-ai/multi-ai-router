#!/bin/sh
# Reproduce the CI quality gate locally: lint, typecheck, test, in order.
set -eu

cd "$(dirname "$0")/.."

# Same flag CI uses, so a stale lockfile fails here instead of on the PR.
bun install --frozen-lockfile

# Sequential and fail-fast (set -e): stop at the first gate that breaks, exactly
# like reading the CI job list top to bottom.
bun run lint
bun run typecheck
bin/test
