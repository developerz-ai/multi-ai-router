{
  "name": "@multi-ai-router/db",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "files": [
    "src",
    "migrations",
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "migrate": "bun run src/migrate.ts"
  },
  "dependencies": {
    "@multi-ai-router/core": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.1"
  }
}
