{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-types",
      "!**/node_modules",
      "!tmp",
      "!**/*.md",
      "!packages/db/migrations",
      "!.claude",
      "!docker-compose.yml",
      "!docker-compose.dev.yml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnknownUnit": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "bin/**",
        "native/**",
        "apps/api/bench/**",
        "apps/api/smoke/**",
        "apps/api/advisory/**",
        "apps/web/ui-geometry/**"
      ],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "includes": [
        "bin/lib/claude-trace/fast-scenarios.ts",
        "apps/api/src/services/usage-report/types.ts",
        "apps/web/src/styles/_tokens.scss"
      ],
      "linter": { "rules": { "correctness": { "noUnknownUnit": "off" } } }
    },
    {
      "includes": ["apps/web/src/styles/reset.scss"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "asNeeded" }
  }
}
