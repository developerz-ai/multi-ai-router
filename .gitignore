# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
native/config-owner
dist/
build/
apps/web/dist/
apps/web/dist-types-gate/
*.tsbuildinfo

# Environment — real secrets, never committed
.env
.env.*
!.env.example

# Database dumps. pg_dump output contains the encrypted credential and router-key
# columns — ciphertext, but never worth committing.
*.sql
*.dump
data/

# ...but generated migrations ARE source and must be committed: the image applies
# them at boot, and CI's integration test applies them against a real Postgres.
# Without this negation `*.sql` above swallows them, leaving a meta/_journal.json
# that references a file nobody else has — which passes locally (the file is on
# disk, just untracked) and fails only on a fresh checkout.
!packages/db/migrations/**/*.sql

# ...and so is one audit artifact: the read-only production queries the 102
# router-audit plan links from 13-production.md ("Reproducible read-only
# queries"). The link is the artifact's index; a linked-but-untrackable path
# makes the plan's evidence unverifiable from a fresh checkout.
#
# The path is named EXACTLY, never `!docs/**/*.sql`: a blanket negation would
# re-admit every pg_dump under docs/, which is the thing `*.sql` above exists
# to keep out of the repository (dumps carry encrypted credential columns).
!docs/plans/2026/10/02/102-full-router-audit/evidence/production.sql

# Per-Account CLAUDE_CONFIG_DIR trees. These hold live Claude subscription
# credentials in cleartext — the single most dangerous thing that could land in
# a commit. See docs/idea/07-security.md.
.claude-config/
claude-config/

# Test / coverage output
coverage/
.nyc_output/
*.lcov

# Cloned reference repos and scratch work. These are read-only research inputs
# (upstream clients we reverse-engineer provider flows from) and MUST NEVER be
# committed — wrong licenses, huge history, not ours.
tmp/

# Logs
*.log
logs/
npm-debug.log*
bun-debug.log*

# ...and so is one audit artifact: the captured baseline unit-test run the 102
# router-audit plan links from 04-providers.md, 05-claude-sdk.md and
# 06-translation.md. A test-run log is noise to `*.log` and evidence to the
# plan, which cites it as the "before" baseline the later runs are compared to.
#
# The path is named EXACTLY, never `!docs/**/*.log`: a blanket negation would
# re-admit every runtime log under docs/ — application output, which may carry
# request ids and upstream error text — and `*.log` above exists to keep it out.
!docs/plans/2026/10/02/102-full-router-audit/04-06-unit-tests.log

# Caches
.cache/
.vite/
.turbo/

# Local agent / tooling state — machine-specific, not part of the project
.claude-task-master/
.ai-task-master/
.playwright-mcp/

# Editors
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
