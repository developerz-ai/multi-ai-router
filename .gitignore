# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
native/config-owner
dist/
build/
apps/web/dist/
apps/web/dist-types-gate/
*.tsbuildinfo

# Environment — real secrets, never committed
.env
.env.*
!.env.example

# Database dumps. pg_dump output contains the encrypted credential and router-key
# columns — ciphertext, but never worth committing.
*.sql
*.dump
data/

# ...but generated migrations ARE source and must be committed: the image applies
# them at boot, and CI's integration test applies them against a real Postgres.
# Without this negation `*.sql` above swallows them, leaving a meta/_journal.json
# that references a file nobody else has — which passes locally (the file is on
# disk, just untracked) and fails only on a fresh checkout.
!packages/db/migrations/**/*.sql

# ...but the audit's saved read-only queries ARE evidence the plan documents link directly
# (13-production.md) — queries only, unlike the credential-bearing dumps the *.sql rule exists
# for. Without this negation the link is dead on every fresh checkout.
!docs/plans/2026/10/02/102-full-router-audit/evidence/production.sql

# Per-Account CLAUDE_CONFIG_DIR trees. These hold live Claude subscription
# credentials in cleartext — the single most dangerous thing that could land in
# a commit. See docs/idea/07-security.md.
.claude-config/
claude-config/

# Test / coverage output
coverage/
.nyc_output/
*.lcov

# Cloned reference repos and scratch work. These are read-only research inputs
# (upstream clients we reverse-engineer provider flows from) and MUST NEVER be
# committed — wrong licenses, huge history, not ours.
tmp/

# Logs
*.log
logs/
npm-debug.log*
bun-debug.log*

# ...but the audit's baseline unit-run capture IS evidence: the 04-, 05- and 06- plan slices
# link it directly, and without this negation those links are dead on every fresh checkout.
# Only this one capture is tracked — every other log stays ignored.
!docs/plans/2026/10/02/102-full-router-audit/04-06-unit-tests.log

# Caches
.cache/
.vite/
.turbo/
__pycache__/

# Local agent / tooling state — machine-specific, not part of the project
.claude-task-master/
.ai-task-master/
.playwright-mcp/

# Editors
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
