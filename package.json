{
  "name": "multi-ai-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bin/dev",
    "build": "bin/build",
    "build:types": "bun run --filter '*' build",
    "test": "bin/test",
    "typecheck": "tsc --build --verbose",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "ci": "bin/ci"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
