{
  "name": "multi-ai-router",
  "version": "2.59.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bin/build",
    "check": "bin/check",
    "db:generate": "bin/db generate",
    "db:migrate": "bin/db migrate",
    "dev": "bin/dev",
    "fmt": "bin/fmt",
    "lint": "biome check .",
    "setup": "bin/setup",
    "test": "bin/test",
    "typecheck": "tsc --build --verbose && tsc --project apps/api/tsconfig.tests.json && tsc --project packages/core/tsconfig.tests.json && tsc --project packages/db/tsconfig.tests.json && tsc --project apps/web/tsconfig.tests.json && tsc --project tsconfig.tools.json"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@types/bun": "^1.4.4",
    "playwright": "1.64.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils>esbuild": "0.25.12",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "glob": "14.0.2",
    "happy-dom": "21.0.4",
    "ip-address": "10.7.4",
    "minimatch": "11.0.1",
    "qs": "6.16.1",
    "seroval": "1.6.11"
  }
}
