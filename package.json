{
  "name": "multi-ai-router",
  "version": "2.23.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bin/build",
    "build:types": "bun run --filter '*' build",
    "check": "bin/check",
    "db:generate": "bin/db generate",
    "db:migrate": "bin/db migrate",
    "dev": "bin/dev",
    "fmt": "biome check --write .",
    "lint": "biome check .",
    "setup": "bin/setup",
    "test": "bin/test",
    "typecheck": "tsc --build --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils>esbuild": "0.25.12"
  }
}
